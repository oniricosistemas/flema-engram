{
  "name": "opencode-flema-engram-sidebar",
  "version": "0.1.1",
  "description": "Local-first OpenCode plugin/sidebar for Engram memory and SDD context, with an optional MCP stdio adapter",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/sidebar/plugin.d.ts",
      "import": "./dist/sidebar/plugin.js"
    }
  },
  "bin": {
    "mcp-flema-engram": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "mcp": "tsx src/stdio.ts",
    "verify:package": "node scripts/package-verifier.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-sidebar",
    "tui",
    "sidebar",
    "engram",
    "local-first",
    "developer-tools",
    "sdd",
    "memory",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oniricosistemas/flema-engram.git"
  },
  "bugs": {
    "url": "https://github.com/oniricosistemas/flema-engram/issues"
  },
  "homepage": "https://github.com/oniricosistemas/flema-engram#readme",
  "engines": {
    "node": ">=22",
    "opencode": ">=1.18.25"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opencode-ai/plugin": "^1.18.25",
    "@opentui/solid": "^0.5.9",
    "solid-js": "^1.9.12",
    "tsx": "^4.23.13",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
